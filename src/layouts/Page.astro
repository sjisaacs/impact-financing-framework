---
import Base from './Base.astro';
import { SEQUENCE, FRAMEWORK_NAV } from '../data/site.js';
const { frontmatter = {} } = Astro.props;
const fm = { ...frontmatter, ...Astro.props };
const { title, description, lede, toc = [], bands = false, framework = false, tag, printHero = true } = fm;
const path = Astro.url.pathname;
const i = SEQUENCE.findIndex((s) => s.href === path);
const next = i >= 0 && i < SEQUENCE.length - 1 ? SEQUENCE[i + 1] : null;
---
<Base title={title} description={description}>
  <section class={`bg-gradient-to-b from-slate-50 to-white py-14 md:py-20 border-b border-slate-100 ${printHero ? '' : 'no-print'}`}>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      {tag && <div class="mb-4"><span class={`tag ${tag.cls}`}>{tag.label}</span></div>}
      <h1 class="font-serif text-4xl md:text-5xl text-slate-900 mb-5 leading-tight animate-fade-in-up">{title}</h1>
      {lede && <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed animate-fade-in-up delay-100">{lede}</p>}
    </div>
  </section>
  {framework && (
    <div class="bg-white border-b border-slate-200 no-print">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 flex items-center gap-2 py-3 overflow-x-auto no-scrollbar">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-2 flex-shrink-0">Framework:</span>
        {FRAMEWORK_NAV.map((n) => (
          <a href={n.href} class={`text-sm px-3 py-1.5 rounded-full whitespace-nowrap transition-colors ${path === n.href ? 'bg-blue-900 text-white' : 'text-slate-600 hover:text-blue-900 hover:bg-blue-50'}`} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
        ))}
      </div>
    </div>
  )}
  {toc.length > 0 && (
    <div class="bg-white border-b border-slate-200 sticky top-16 z-40 no-print">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="flex items-center gap-1 py-3 overflow-x-auto no-scrollbar">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-2 flex-shrink-0">Contents:</span>
          {toc.map((s) => (<a href={`#${s.id}`} class="text-xs text-slate-600 hover:text-blue-900 hover:bg-blue-50 px-3 py-1.5 rounded-full whitespace-nowrap transition-colors">{s.label}</a>))}
        </div>
      </div>
    </div>
  )}
  {bands ? <slot /> : (
    <section class="py-14 md:py-16 bg-white"><div class="max-w-3xl mx-auto px-4 sm:px-6 prose-iff"><slot /></div></section>
  )}
  {next && (
    <section class="py-14 bg-slate-50 border-t border-slate-100 no-print">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <p class="text-sm text-slate-500 mb-3">Continue reading</p>
        <a href={next.href} class="inline-flex items-center gap-2 px-8 py-4 bg-blue-900 text-white rounded-lg font-semibold hover:bg-blue-800 transition-colors">
          {next.label}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </section>
  )}
</Base>
