<svg viewBox="0 0 360 225" role="img" aria-labelledby="ht-title ht-desc">
  <title id="ht-title">A transitional access gap</title>
  <desc id="ht-desc">The financial and social landscapes share their lowest point, but capital has pooled in a higher local low point behind a ridge. A temporary path through the ridge lets it reach the shared low point.</desc>
  <Markers id="ht" />
  <path class="soc" d="M20 45 C 120 55, 200 185, 250 185 C 295 185, 320 130, 340 100" />
  <path class="water" d="M65 98 C 72 106, 80 110, 90 110 C 99 110, 105 105, 110 98 Z" />
  <path class="fin" d="M20 55 C 50 80, 70 110, 90 110 C 110 110, 125 70, 150 70 C 180 70, 215 170, 250 170 C 285 170, 315 120, 340 90" />
  <path class="wedge-dash" d="M100 104 L 242 165" marker-end="url(#ht-w)" />
  <text x="22" y="150">capital</text><text x="22" y="168">pools here</text>
  <text x="250" y="210" text-anchor="middle" class="t-strong">shared low point</text>
</svg>
