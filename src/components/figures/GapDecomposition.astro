<svg viewBox="0 0 480 214" role="img" aria-labelledby="gd-title gd-desc">
  <title id="gd-title">Decomposing a gap</title>
  <desc id="gd-desc">Today's price splits into three parts: what end users can pay, a structural gap that a payer must fill, and a transitional gap that a lever can close. Once the transitional gap closes, the price falls to what users can pay plus the structural gap.</desc>
  <line class="ax" x1="30" y1="58" x2="450" y2="58" /><line class="ax" x1="30" y1="52" x2="30" y2="64" /><line class="ax" x1="450" y1="52" x2="450" y2="64" />
  <text x="240" y="46" text-anchor="middle" class="t-strong">price today</text>
  <rect class="box-fill" x="30" y="72" width="140" height="36" />
  <rect x="170" y="72" width="160" height="36" style="fill:#059669; fill-opacity:0.16; stroke:#059669; stroke-width:1.5" />
  <rect x="330" y="72" width="120" height="36" style="fill:#d97706; fill-opacity:0.16; stroke:#d97706; stroke-width:1.5" />
  <text x="100" y="134" text-anchor="middle" class="t-strong">users can pay</text>
  <text x="100" y="152" text-anchor="middle" class="t-small">end-user demand</text>
  <text x="250" y="134" text-anchor="middle" class="t-strong">a payer fills</text>
  <text x="250" y="152" text-anchor="middle" class="t-small">structural gap</text>
  <text x="390" y="134" text-anchor="middle" class="t-strong">a lever closes</text>
  <text x="390" y="152" text-anchor="middle" class="t-small">transitional gap</text>
  <line class="ax" x1="30" y1="178" x2="330" y2="178" /><line class="ax" x1="30" y1="172" x2="30" y2="184" /><line class="ax" x1="330" y1="172" x2="330" y2="184" />
  <text x="180" y="200" text-anchor="middle">price once the transitional gap closes</text>
</svg>
