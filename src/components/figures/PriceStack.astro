---
// Price per unit of outcome as a horizontal bar: cost on the left, margin on the right, so the levers read
// 1 to 6 in order, left column then right column, matching the numbered lever cards below the figure.
const cost = ['Process improvement', 'Scale and learning', 'Capital cost'];
const margin = ['Competition', 'Disintermediation', 'Risk transfer'];
const rowY = [152, 186, 220];
---
<svg viewBox="0 0 480 240" role="img" aria-labelledby="ps-title ps-desc">
  <title id="ps-title">Six levers act on cost or on margin</title>
  <desc id="ps-desc">Price per unit of outcome is the supplier's cost plus its margin. Levers 1 to 3 lower the cost: process improvement, scale and learning, and capital cost. Levers 4 to 6 narrow the margin: competition, disintermediation and risk transfer.</desc>
  <text x="240" y="22" text-anchor="middle" class="t-strong">price per unit of outcome</text>
  <path class="ax" d="M20 40 V32 H460 V40" />
  <rect x="20" y="48" width="250" height="50" style="fill:#1e40af; fill-opacity:0.10; stroke:#1e40af; stroke-width:1.5" />
  <rect x="270" y="48" width="190" height="50" style="fill:#059669; fill-opacity:0.12; stroke:#059669; stroke-width:1.5" />
  <text x="145" y="78" text-anchor="middle" class="t-strong">cost</text>
  <text x="365" y="78" text-anchor="middle" class="t-strong">margin</text>
  <text x="24" y="124" class="t-small" style="fill:#1e3a8a">lower the cost</text>
  <text x="274" y="124" class="t-small" style="fill:#047857">narrow the margin</text>
  {cost.map((label, i) => (
    <g>
      <circle cx="35" cy={rowY[i] - 5} r="11" style="fill:#dbeafe" />
      <text x="35" y={rowY[i]} text-anchor="middle" style="font-size:13px; font-weight:700; fill:#1d4ed8">{i + 1}</text>
      <text x="54" y={rowY[i]}>{label}</text>
    </g>
  ))}
  {margin.map((label, i) => (
    <g>
      <circle cx="285" cy={rowY[i] - 5} r="11" style="fill:#d1fae5" />
      <text x="285" y={rowY[i]} text-anchor="middle" style="font-size:13px; font-weight:700; fill:#047857">{i + 4}</text>
      <text x="304" y={rowY[i]}>{label}</text>
    </g>
  ))}
</svg>
