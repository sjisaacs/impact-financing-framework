<svg viewBox="0 0 480 362" role="img" aria-labelledby="ia-title ia-desc">
  <title id="ia-title">Impact is the area between the outcome with and without the intervention</title>
  <desc id="ia-desc">Top: in a transitional gap, spending is brief and the outcome improves and stays improved. Impact accrues until the market would have reached the same outcome on its own. Bottom: in a structural gap, the outcome would never improve without the intervention, so spending continues and impact lasts only while the payer keeps paying.</desc>
  <text x="30" y="24" class="t-strong">Transitional gap</text>
  <path class="tint-soc" d="M130 140 C 150 140, 155 70, 180 70 L 370 70 C 345 70, 340 140, 320 140 Z" />
  <line class="ax" x1="30" y1="150" x2="450" y2="150" />
  <path class="cf" d="M30 140 H320 C 340 140, 345 70, 370 70 H450" />
  <path class="soc" d="M30 140 H130 C 150 140, 155 70, 180 70 H450" />
  <rect class="d-wedge" x="120" y="158" width="60" height="7" rx="2" />
  <text x="250" y="110" text-anchor="middle" class="t-strong">impact</text>
  <text x="345" y="56" text-anchor="middle" class="t-small">market arrives anyway</text>
  <text x="30" y="214" class="t-strong">Structural gap</text>
  <path class="tint-soc" d="M130 330 C 150 330, 155 260, 180 260 L 350 260 C 370 260, 375 330, 400 330 Z" />
  <line class="ax" x1="30" y1="340" x2="450" y2="340" />
  <path class="soc" d="M30 330 H130 C 150 330, 155 260, 180 260 H350 C 370 260, 375 330, 400 330 H450" />
  <path class="cf" d="M30 330 H450" />
  <rect class="d-wedge" x="120" y="348" width="245" height="7" rx="2" />
  <text x="265" y="302" text-anchor="middle" class="t-strong">impact</text>
  <text x="375" y="248" text-anchor="middle" class="t-small">payer stops</text>
</svg>
