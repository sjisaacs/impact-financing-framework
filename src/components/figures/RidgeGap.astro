<svg viewBox="0 0 480 235" role="img" aria-labelledby="rg-title rg-desc">
  <title id="rg-title">A transitional access gap is a ridge between two valleys</title>
  <desc id="rg-desc">Capital has pooled in a local low point of the financial landscape. A lower, better valley lies beyond a ridge of temporary losses. A temporary path through the ridge lets capital reach it, after which it stays.</desc>
  <Markers id="rg" />
  <path class="water" d="M84 118 C 93 126, 101 130, 110 130 C 120 130, 129 125, 136 118 Z" />
  <path class="fin" d="M30 60 C 60 90, 85 130, 110 130 C 140 130, 165 75, 200 75 C 240 75, 290 200, 340 200 C 390 200, 425 150, 450 110" />
  <path class="wedge-dash" d="M120 133 L 330 197" marker-end="url(#rg-w)" />
  <text x="92" y="160" text-anchor="middle">capital</text><text x="92" y="178" text-anchor="middle">pools here</text>
  <text x="200" y="52" text-anchor="middle" class="t-strong" style="fill:#b45309">temporary path through the ridge</text>
  <text x="340" y="224" text-anchor="middle" class="t-strong">better low point</text>
</svg>
