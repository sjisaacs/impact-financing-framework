<svg viewBox="0 0 480 384" role="img" aria-labelledby="nm-title nm-desc">
  <title id="nm-title">What to do first depends on whether a buyer exists</title>
  <desc id="nm-desc">A two by two grid. Horizontal axis: a buyer at scale is absent or present. Vertical axis: transitional gap small or large. With a buyer and a large transitional gap, shape the market with the buyer, as with contraceptive implants and TLD. Without a buyer and with a large transitional gap, secure a buyer first and then shape the market, as with carbon removal. Without a buyer and a small transitional gap, secure a buyer, as with mental health care in many low- and middle-income countries. With a buyer and a small gap, maintain and monitor.</desc>
  <text x="76" y="24" class="t-strong t-small">transitional gap</text>
  <text x="68" y="62" text-anchor="end" class="t-small">large</text>
  <text x="68" y="318" text-anchor="end" class="t-small">small</text>
  <rect class="box" x="76" y="38" width="192" height="140" rx="6" />
  <text x="90" y="64" class="t-strong">Secure a buyer</text>
  <text x="90" y="84" class="t-strong">first, then shape</text>
  <text x="90" y="114" class="t-small">Carbon removal</text>
  <rect class="box-fill" x="278" y="38" width="192" height="140" rx="6" />
  <text x="292" y="64" class="t-strong">Shape the market</text>
  <text x="292" y="84" class="t-strong">with the buyer</text>
  <text x="292" y="114" class="t-small">Contraceptive</text>
  <text x="292" y="132" class="t-small">implants, TLD</text>
  <text x="292" y="150" class="t-small">for HIV</text>
  <rect class="box" x="76" y="188" width="192" height="140" rx="6" />
  <text x="90" y="214" class="t-strong">Secure a buyer</text>
  <text x="90" y="244" class="t-small">Mental health care</text>
  <text x="90" y="262" class="t-small">in many low- and</text>
  <text x="90" y="280" class="t-small">middle-income</text>
  <text x="90" y="298" class="t-small">countries</text>
  <rect class="box" x="278" y="188" width="192" height="140" rx="6" />
  <text x="292" y="214" class="t-strong">Maintain and</text>
  <text x="292" y="234" class="t-strong">monitor</text>
  <text x="292" y="264" class="t-small">Routine</text>
  <text x="292" y="282" class="t-small">procurement</text>
  <text x="172" y="350" text-anchor="middle" class="t-small">absent</text>
  <text x="374" y="350" text-anchor="middle" class="t-small">present</text>
  <text x="273" y="374" text-anchor="middle" class="t-strong t-small">buyer at scale</text>
</svg>
