---
import Markers from './Markers.astro';
---
<svg viewBox="0 0 480 362" role="img" aria-labelledby="wg-title wg-desc">
  <title id="wg-title">The geometry of an externality</title>
  <desc id="wg-desc">At the market's low point the financial landscape is flat, but the social landscape still slopes; that slope is the wedge. The horizontal distance between the two low points is the displacement. The rise in the social landscape from its own low point to the market's position is the welfare at stake.</desc>
  <Markers id="wg" />
  <line class="ax" x1="30" y1="270" x2="450" y2="270" />
  <line class="guide" x1="150" y1="270" x2="150" y2="245" />
  <line class="guide" x1="280" y1="270" x2="280" y2="255" />
  <line class="guide" x1="158" y1="240" x2="410" y2="240" />
  <line class="guide" x1="288" y1="160" x2="410" y2="160" />
  <path class="soc" d="M30 90 C 80 210, 120 240, 150 240 C 190 240, 240 195, 280 160 C 320 130, 390 95, 450 85" />
  <path class="fin" d="M30 75 C 140 90, 210 250, 280 250 C 320 250, 345 180, 370 70" />
  <line class="wedge" style="stroke-width:3.5" x1="250" y1="182.5" x2="310" y2="137.5" />
  <circle class="d-soc" cx="150" cy="240" r="5" />
  <circle class="d-fin" cx="280" cy="250" r="5" />
  <circle class="d-soc" cx="280" cy="160" r="5" />
  <line x1="400" y1="166" x2="400" y2="234" style="stroke:#475569; stroke-width:1.5" marker-start="url(#wg-k)" marker-end="url(#wg-k)" />
  <text x="400" y="258" text-anchor="middle" class="t-strong">welfare at stake</text>
  <text x="300" y="124" text-anchor="end" class="t-strong" style="fill:#b45309">wedge</text>
  <text x="150" y="290" text-anchor="middle">social</text><text x="150" y="308" text-anchor="middle">low point</text>
  <text x="280" y="290" text-anchor="middle">market's</text><text x="280" y="308" text-anchor="middle">low point</text>
  <line x1="156" y1="328" x2="274" y2="328" style="stroke:#475569; stroke-width:1.5" marker-start="url(#wg-k)" marker-end="url(#wg-k)" />
  <text x="215" y="350" text-anchor="middle" class="t-strong">displacement</text>
</svg>
