---
import Markers from './Markers.astro';
---
<svg viewBox="0 0 480 240" role="img" aria-labelledby="tf-title tf-desc">
  <title id="tf-title">A structural misalignment is fixed by terraforming the financial landscape</title>
  <desc id="tf-desc">The old financial low point is far from the social low point. Taxing the harm raises the floor of the old low point, and paying for the good lowers the floor near the social low point, so capital now pools where the social landscape is lowest.</desc>
  <Markers id="tf" />
  <path class="soc" d="M30 65 C 70 135, 110 195, 150 195 C 195 195, 300 95, 450 70" />
  <path class="fin-faint" d="M30 60 C 150 65, 270 185, 330 185 C 380 185, 420 135, 450 105" />
  <path class="water" d="M121 165 C 132 172, 140 175, 150 175 C 165 175, 182 172, 196 165 Z" />
  <path class="fin" d="M30 65 C 75 115, 110 175, 150 175 C 200 175, 330 105, 450 80" />
  <line class="wedge" x1="330" y1="180" x2="330" y2="124" marker-end="url(#tf-w)" />
  <line class="wedge" x1="150" y1="102" x2="150" y2="160" marker-end="url(#tf-w)" />
  <text x="150" y="226" text-anchor="middle">pay for the good</text>
  <text x="330" y="226" text-anchor="middle">tax the harm</text>
</svg>
