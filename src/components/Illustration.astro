---
// Responsive illustration from public/images (WebP at 900 and 1600 px wide).
interface Props { name: string; alt: string; width: number; height: number; eager?: boolean; }
const { name, alt, width, height, eager = false } = Astro.props;
---
<img
  src={`/images/${name}-1600.webp`}
  srcset={`/images/${name}-900.webp 900w, /images/${name}-1600.webp 1600w`}
  sizes="(min-width: 1024px) 864px, 100vw"
  width={width} height={height} alt={alt}
  loading={eager ? 'eager' : 'lazy'} decoding="async"
  class="w-full h-auto rounded-lg"
/>
