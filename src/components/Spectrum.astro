---
interface Point { pos: number; label: string }
const { label, question, left, right, gradient, points } = Astro.props as { label: string; question: string; left: string; right: string; gradient: string; points: Point[] };
---
<div class="mb-10">
  <div class="mb-3"><div class="font-semibold text-slate-800">{label}</div><div class="text-xs text-slate-500">{question}</div></div>
  <div class="flex justify-between text-xs font-medium text-slate-500 mb-2"><span>{left}</span><span>{right}</span></div>
  <div class={`spectrum-track ${gradient} mb-3`}></div>
  <div class="relative h-10">
    {points.map((p) => (
      <div class="absolute -translate-x-1/2 text-center text-[11px] text-slate-600 whitespace-nowrap" style={`left:${p.pos}%`}>
        <div class="w-2.5 h-2.5 rounded-full bg-slate-700 mx-auto mb-1"></div>{p.label}
      </div>
    ))}
  </div>
</div>
